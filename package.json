{
  "name": "ponerse-papota-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.11",
  "engines": {
    "node": ">=22.22.1 <23",
    "npm": ">=10.9.11 <11"
  },
  "dependencies": {
    "expo": "58.0.26",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.21",
    "expo-linking": "58.0.17",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.32",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "19.3.3",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "build": "expo export --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write app src \"[!.]*.{js,ts,json}\" README.md",
    "format:check": "prettier --check app src \"[!.]*.{js,ts,json}\" README.md"
  }
}
